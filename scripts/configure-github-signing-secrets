#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
secret_file="$repo_root/secrets/android-signing.yaml"
github_repo="${1:-codyps/CellScope}"

if [[ ! -f "$secret_file" ]]; then
  echo "Encrypted signing material not found: $secret_file" >&2
  exit 1
fi

if ! command -v gh >/dev/null 2>&1; then
  echo "gh is required" >&2
  exit 1
fi

if command -v sops >/dev/null 2>&1; then
  sops_command=(sops)
elif command -v nix >/dev/null 2>&1; then
  sops_command=(nix shell nixpkgs#sops --command sops)
else
  echo "sops is required (or install Nix so the script can run it ephemerally)" >&2
  exit 1
fi

gh auth status >/dev/null

set_secret() {
  local encrypted_field="$1"
  local github_name="$2"

  "${sops_command[@]}" --decrypt \
    --extract "[\"$encrypted_field\"]" \
    --output-type binary \
    "$secret_file" | gh secret set "$github_name" --repo "$github_repo"
  echo "Configured $github_name in $github_repo"
}

set_secret keystore_base64 ANDROID_SIGNING_KEY_BASE64
set_secret store_password ANDROID_SIGNING_STORE_PASSWORD
set_secret key_alias ANDROID_SIGNING_KEY_ALIAS
set_secret key_password ANDROID_SIGNING_KEY_PASSWORD
